# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-opus-5-5

# Local model via Ollama (--provider local)
# LOCAL_MODEL=qwen3.6:latest
# LOCAL_URL=http://localhost:11434/v1
# LOCAL_TEMPERATURE=0.6

# RAG
# EMBED_MODEL=qwen3-embedding:0.6b
# RAG_COLLECTION=docs
# QDRANT_PATH=./qdrant_data
# QDRANT_URL=http://localhost:6333   # use a Qdrant server instead of the embedded store

# Desktop app (python -m app): collection it indexes into and answers from
# APP_COLLECTION=work

# Reranking: cross-encoder reorders the top hybrid candidates; RERANK_MODEL= disables it
# RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
# RERANK_CANDIDATES=16
